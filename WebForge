    <!-- JavaScript Application Logic & CMS Engine -->
    <script>
        // Default Data State
        const defaultState = {
            heroTitle: "WebForge: Forjando o futuro digital da sua empresa",
            heroSubtitle: "Desenvolvemos sites profissionais, sistemas de automação sob medida e portais corporativos de alto desempenho para pequenos e grandes negócios.",
            services: [
                {
                    id: 1,
                    icon: "fa-solid fa-store",
                    title: "Pequenas Empresas",
                    description: "Sites institucionais modernos, rápidos e focados em transformar visitantes locais em clientes fiéis."
                },
                {
                    id: 2,
                    icon: "fa-solid fa-building-columns",
                    title: "Grandes Corporações",
                    description: "Portais empresariais robustos, seguros e escaláveis para suportar grandes fluxos de acesso."
                },
                {
                    id: 3,
                    icon: "fa-solid fa-robot",
                    title: "Automação Digital",
                    description: "Sistemas inteligentes integrados que automatizam atendimento, vendas e fluxos internos da sua empresa."
                },
                {
                    id: 4,
                    icon: "fa-solid fa-gauge-high",
                    title: "Web Apps de Alta Performance",
                    description: "Aplicações web sob medida construídas com as tecnologias mais modernas do mercado."
                }
            ],
            portfolio: [
                {
                    id: 1,
                    title: "Portal Logística Global",
                    category: "Grandes Empresas",
                    description: "Sistema automatizado de rastreio e gestão corporativa.",
                    image: "https://placehold.co/600x400/111827/00f0ff?text=Logistica+Global"
                },
                {
                    id: 2,
                    title: "E-Commerce Boutique Prime",
                    category: "Pequeno Porte",
                    description: "Loja virtual elegante com gateway de pagamento integrado.",
                    image: "https://placehold.co/600x400/111827/7928ca?text=Boutique+Prime"
                },
                {
                    id: 3,
                    title: "Dashboard de Automação CRM",
                    category: "Automação Digital",
                    description: "Painel de controle com automação de leads em tempo real.",
                    image: "https://placehold.co/600x400/111827/00f0ff?text=CRM+Automacao"
                }
            ]
        };

        // Load State from LocalStorage or Fallback to Default
        let appData = JSON.parse(localStorage.getItem('webforge_data')) || defaultState;

        function saveAppData() {
            localStorage.setItem('webforge_data', JSON.stringify(appData));
            renderPublicSite();
        }

        function resetDefaultData() {
            if (confirm('Deseja realmente restaurar os dados originais padrão?')) {
                appData = JSON.parse(JSON.stringify(defaultState));
                saveAppData();
                showToast('Dados restaurados com sucesso!', 'success');
                renderAdminDashboard();
            }
        }

        function exportSiteData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "webforge_backup.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast('Backup exportado com sucesso!', 'success');
        }

        // Custom Toast Notification (Replaces alert)
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bg = type === 'success' ? 'bg-cyan-500 text-black font-bold' : 'bg-gray-900 text-white border border-gray-700';
            toast.className = `${bg} px-5 py-3 rounded-xl shadow-neon text-sm flex items-center space-x-3 transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto`;
            toast.innerHTML = `<i class="fa-solid fa-circle-info"></i><span>${message}</span>`;
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Render Public Website Components
        function renderPublicSite() {
            // Hero
            document.getElementById('hero-title').innerText = appData.heroTitle;
            document.getElementById('hero-subtitle').innerText = appData.heroSubtitle;

            // Services
            const servicesGrid = document.getElementById('services-grid');
            servicesGrid.innerHTML = appData.services.map(s => `
                <div class="glass-panel p-8 rounded-3xl hover:border-accentBlue/50 transition-all group">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-accentBlue/20 to-accentPurple/20 border border-accentBlue/30 flex items-center justify-center text-accentBlue text-xl mb-6 group-hover:scale-110 transition-transform shadow-neon">
                        <i class="${s.icon}"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-3">${s.title}</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">${s.description}</p>
                </div>
            `).join('');

            // Portfolio
            const portfolioGrid = document.getElementById('portfolio-grid');
            portfolioGrid.innerHTML = appData.portfolio.map(p => `
                <div class="glass-panel rounded-3xl overflow-hidden hover:border-accentBlue/40 transition-all group">
                    <div class="h-48 overflow-hidden relative">
                        <img src="${p.image}" alt="${p.title}" onerror="this.src='https://placehold.co/600x400/111827/00f0ff?text=WebForge+Project'" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/70 backdrop-blur-md text-[10px] font-extrabold text-accentBlue uppercase tracking-wider border border-accentBlue/30">
                            ${p.category}
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-bold mb-2">${p.title}</h3>
                        <p class="text-gray-400 text-sm">${p.description}</p>
                    </div>
                </div>
            `).join('');
        }

        // Admin Modal Controls
        function openAdminLoginModal() {
            document.getElementById('admin-login-modal').classList.remove('hidden');
        }

        function closeAdminLoginModal() {
            document.getElementById('admin-login-modal').classList.add('hidden');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const user = document.getElementById('admin-user-input').value.trim();
            const pass = document.getElementById('admin-pass-input').value.trim();

            if (user === 'zayro' && pass === '2011') {
                closeAdminLoginModal();
                document.getElementById('admin-dashboard').classList.remove('hidden');
                document.getElementById('admin-user-input').value = '';
                document.getElementById('admin-pass-input').value = '';
                renderAdminDashboard();
                showToast('Login de Administrador Master realizado com sucesso!', 'success');
            } else {
                showToast('Credenciais incorretas! Tente usuário "zayro" e senha "2011".', 'error');
            }
        }

        function closeAdminDashboard() {
            document.getElementById('admin-dashboard').classList.add('hidden');
            showToast('Você saiu do painel administrativo.', 'info');
        }

        // Render Admin Dashboard Lists & Inputs
        function renderAdminDashboard() {
            document.getElementById('edit-hero-title').value = appData.heroTitle;
            document.getElementById('edit-hero-subtitle').value = appData.heroSubtitle;

            // Render Admin Services Management
            const adminServList = document.getElementById('admin-services-list');
            adminServList.innerHTML = appData.services.map((s, index) => `
                <div class="p-4 rounded-2xl bg-[#090d16] border border-gray-800 flex items-center justify-between gap-4">
                    <div>
                        <span class="text-xs font-bold text-accentBlue uppercase">${s.title}</span>
                        <p class="text-xs text-gray-400 mt-1 line-clamp-1">${s.description}</p>
                    </div>
                    <button onclick="deleteService(${index})" class="px-3 py-1.5 rounded-lg bg-red-900/30 text-red-400 hover:bg-red-900/50 text-xs font-semibold">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `).join('');

            // Render Admin Portfolio Management
            const adminPortList = document.getElementById('admin-portfolio-list');
            adminPortList.innerHTML = appData.portfolio.map((p, index) => `
                <div class="p-4 rounded-2xl bg-[#090d16] border border-gray-800 flex items-center justify-between gap-4">
                    <div class="flex items-center space-x-3">
                        <img src="${p.image}" class="w-12 h-12 rounded-xl object-cover" onerror="this.src='https://placehold.co/100x100/111827/00f0ff?text=IMG'">
                        <div>
                            <h4 class="text-sm font-bold text-white">${p.title}</h4>
                            <span class="text-[10px] text-gray-400">${p.category}</span>
                        </div>
                    </div>
                    <button onclick="deletePortfolioItem(${index})" class="px-3 py-1.5 rounded-lg bg-red-900/30 text-red-400 hover:bg-red-900/50 text-xs font-semibold">
                        <i class="fa-solid fa-trash mr-1"></i> Remover
                    </button>
                </div>
            `).join('');
        }

        // CMS Actions
        function saveHeroChanges() {
            appData.heroTitle = document.getElementById('edit-hero-title').value;
            appData.heroSubtitle = document.getElementById('edit-hero-subtitle').value;
            saveAppData();
            showToast('Seção Principal atualizada com sucesso!', 'success');
        }

        function deleteService(index) {
            appData.services.splice(index, 1);
            saveAppData();
            renderAdminDashboard();
            showToast('Serviço removido com sucesso!', 'success');
        }

        function openAddServiceModal() {
            const title = prompt('Título do novo serviço:');
            if (!title) return;
            const desc = prompt('Descrição do serviço:');
            if (!desc) return;
            appData.services.push({
                id: Date.now(),
                icon: "fa-solid fa-circle-check",
                title: title,
                description: desc
            });
            saveAppData();
            renderAdminDashboard();
            showToast('Novo serviço adicionado!', 'success');
        }

        // Add Portfolio Item with File Reader Image Upload Support
        function addPortfolioItem() {
            const title = document.getElementById('new-port-title').value.trim();
            const category = document.getElementById('new-port-category').value.trim();
            const desc = document.getElementById('new-port-desc').value.trim();
            const urlInput = document.getElementById('new-port-img-url').value.trim();
            const fileInput = document.getElementById('new-port-file');

            if (!title || !category || !desc) {
                showToast('Preencha todos os campos do portfólio!', 'error');
                return;
            }

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    pushPortfolioRecord(title, category, desc, e.target.result);
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                const finalImg = urlInput !== "" ? urlInput : "https://placehold.co/600x400/111827/00f0ff?text=" + encodeURIComponent(title);
                pushPortfolioRecord(title, category, desc, finalImg);
            }
        }

        function pushPortfolioRecord(title, category, desc, imageSrc) {
            appData.portfolio.push({
                id: Date.now(),
                title: title,
                category: category,
                description: desc,
                image: imageSrc
            });
            saveAppData();
            renderAdminDashboard();

            // Clear inputs
            document.getElementById('new-port-title').value = '';
            document.getElementById('new-port-category').value = '';
            document.getElementById('new-port-desc').value = '';
            document.getElementById('new-port-img-url').value = '';
            document.getElementById('new-port-file').value = '';

            showToast('Projeto e imagem adicionados ao site com sucesso!', 'success');
        }

        function deletePortfolioItem(index) {
            appData.portfolio.splice(index, 1);
            saveAppData();
            renderAdminDashboard();
            showToast('Projeto removido do portfólio!', 'success');
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('contact-name').value;
            showToast(`Obrigado, ${name}! Sua solicitação foi enviada com sucesso à equipe WebForge.`, 'success');
            document.getElementById('contact-form').reset();
        }

        // Initialize on load
        window.onload = function() {
            renderPublicSite();
        }
    </script>
</body>
