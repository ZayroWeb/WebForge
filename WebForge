<!DOCTYPE html>
<html lang="pt-BR" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebForge - Desenvolvimento Digital & Automação</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#090d16',
                        cardBg: '#111827',
                        accentBlue: '#00f0ff',
                        accentPurple: '#7928ca',
                    },
                    boxShadow: {
                        neon: '0 0 25px rgba(0, 240, 255, 0.25)',
                        'neon-purple': '0 0 25px rgba(121, 40, 202, 0.3)',
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for professional icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #090d16;
            color: #f3f4f6;
        }
        .glass-panel {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .hero-gradient {
            background: radial-gradient(circle at 50% 20%, rgba(0, 240, 255, 0.15), rgba(121, 40, 202, 0.1), transparent 70%);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f2937;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #374151;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-accentBlue selection:text-black">

    <!-- Notification Toast (Replaces alert) -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-40 glass-panel border-b border-gray-800/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-accentBlue to-accentPurple flex items-center justify-center shadow-neon transition-transform duration-300 group-hover:scale-105">
                    <i class="fa-solid fa-cube text-black font-bold text-lg"></i>
                </div>
                <div class="flex flex-col">
                    <span class="text-xl font-extrabold tracking-wider bg-gradient-to-r from-white via-cyan-200 to-accentBlue bg-clip-text text-transparent">WEBFORGE</span>
                    <span class="text-[10px] text-gray-400 tracking-widest uppercase">Digital Agency</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
                <a href="#services" class="text-gray-300 hover:text-accentBlue transition-colors">Serviços</a>
                <a href="#portfolio" class="text-gray-300 hover:text-accentBlue transition-colors">Portfólio</a>
                <a href="#about" class="text-gray-300 hover:text-accentBlue transition-colors">Sobre</a>
                <a href="#contact" class="text-gray-300 hover:text-accentBlue transition-colors">Contato</a>
            </nav>

            <!-- Actions / Admin Toggle -->
            <div class="flex items-center space-x-4">
                <button onclick="openAdminLoginModal()" class="relative group px-4 py-2 rounded-xl bg-gradient-to-r from-accentBlue/10 to-accentPurple/10 border border-accentBlue/30 hover:border-accentBlue text-accentBlue text-xs sm:text-sm font-semibold transition-all duration-300 shadow-neon flex items-center space-x-2">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span id="admin-btn-text">Área Admin</span>
                </button>
                <a href="#contact" class="hidden sm:inline-flex px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-black font-bold text-sm shadow-neon transition-all duration-300 transform hover:-translate-y-0.5">
                    Orçamento
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Wrapper -->
    <main class="flex-grow">
        <!-- Hero Section -->
        <section class="relative overflow-hidden hero-gradient py-24 sm:py-32">
            <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-20 pointer-events-none"></div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-accentBlue/10 border border-accentBlue/20 text-accentBlue text-xs font-semibold mb-6 shadow-neon">
                    <i class="fa-solid fa-bolt text-accentBlue"></i>
                    <span>Tecnologia de Ponta & Automação Web</span>
                </div>
                <h1 id="hero-title" class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight max-w-4xl mx-auto leading-tight mb-6">
                    WebForge: Forjando o futuro digital da sua empresa
                </h1>
                <p id="hero-subtitle" class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto mb-10">
                    Desenvolvemos sites profissionais, sistemas de automação sob medida e portais corporativos de alto desempenho para pequenos e grandes negócios.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center space-y-4 sm:space-y-0 sm:space-x-5">
                    <a href="#services" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-accentBlue to-blue-600 text-black font-bold text-base shadow-neon hover:opacity-90 transition-all transform hover:-translate-y-0.5 text-center">
                        Nossos Serviços
                    </a>
                    <a href="#contact" class="w-full sm:w-auto px-8 py-4 rounded-xl glass-panel hover:bg-gray-800 text-white font-semibold text-base border border-gray-700 transition-all text-center">
                        Solicitar Orçamento
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="services" class="py-20 relative bg-[#090d16]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Soluções Especializadas</h2>
                    <p class="text-gray-400 max-w-xl mx-auto">Arquitetura web escalável e moderna projetada para elevar o patamar da sua marca.</p>
                </div>
                <div id="services-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <!-- Dynamic services inserted by JS -->
                </div>
            </div>
        </section>

        <!-- Portfolio / Cases Section -->
        <section id="portfolio" class="py-20 bg-[#070a12] border-t border-b border-gray-900">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Portfólio de Projetos</h2>
                    <p class="text-gray-400 max-w-xl mx-auto">Conheça alguns dos ecossistemas digitais e sites desenvolvidos por nossa agência.</p>
                </div>
                <div id="portfolio-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Dynamic portfolio inserted by JS -->
                </div>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="py-20 relative">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="glass-panel p-8 sm:p-12 rounded-3xl relative overflow-hidden">
                    <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-accentPurple/20 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <div>
                            <h2 class="text-3xl font-bold mb-6">Por que escolher a WebForge?</h2>
                            <p class="text-gray-300 leading-relaxed mb-6">
                                Nascemos com o propósito de transformar a presença digital de empresas de todos os portes. Combinamos design futurista, código limpo e sistemas automatizados para garantir que seu negócio opere em velocidade máxima.
                            </p>
                            <ul class="space-y-4">
                                <li class="flex items-center space-x-3 text-gray-300">
                                    <i class="fa-solid fa-check text-accentBlue"></i>
                                    <span>Interfaces responsivas otimizadas para conversão</span>
                                </li>
                                <li class="flex items-center space-x-3 text-gray-300">
                                    <i class="fa-solid fa-check text-accentBlue"></i>
                                    <span>Integração com automações e inteligência comercial</span>
                                </li>
                                <li class="flex items-center space-x-3 text-gray-300">
                                    <i class="fa-solid fa-check text-accentBlue"></i>
                                    <span>Painel administrativo intuitivo e totalmente customizável</span>
                                </li>
                            </ul>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="glass-panel p-6 rounded-2xl text-center">
                                <span class="block text-3xl font-extrabold text-accentBlue mb-1">+150</span>
                                <span class="text-xs text-gray-400 uppercase tracking-wider">Sites Entregues</span>
                            </div>
                            <div class="glass-panel p-6 rounded-2xl text-center">
                                <span class="block text-3xl font-extrabold text-accentPurple mb-1">99.9%</span>
                                <span class="text-xs text-gray-400 uppercase tracking-wider">Uptime Garantido</span>
                            </div>
                            <div class="glass-panel p-6 rounded-2xl text-center">
                                <span class="block text-3xl font-extrabold text-green-400 mb-1">24/7</span>
                                <span class="text-xs text-gray-400 uppercase tracking-wider">Suporte Técnico</span>
                            </div>
                            <div class="glass-panel p-6 rounded-2xl text-center">
                                <span class="block text-3xl font-extrabold text-yellow-400 mb-1">100%</span>
                                <span class="text-xs text-gray-400 uppercase tracking-wider">Personalizado</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="py-20 bg-[#070a12]">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold mb-3">Fale com Nossos Especialistas</h2>
                    <p class="text-gray-400">Pronto para forjar o próximo grande passo da sua empresa? Envie sua mensagem.</p>
                </div>
                <form id="contact-form" onsubmit="handleContactSubmit(event)" class="glass-panel p-8 sm:p-10 rounded-3xl space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-2 font-semibold">Nome Completo</label>
                            <input type="text" id="contact-name" required placeholder="Seu nome" class="w-full bg-[#090d16] border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accentBlue transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-2 font-semibold">E-mail Corporativo</label>
                            <input type="email" id="contact-email" required placeholder="seu@email.com" class="w-full bg-[#090d16] border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accentBlue transition-colors">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-gray-400 mb-2 font-semibold">Detalhes do Projeto / Empresa</label>
                        <textarea id="contact-message" rows="4" required placeholder="Conte-nos sobre sua empresa e o que precisa..." class="w-full bg-[#090d16] border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accentBlue transition-colors"></textarea>
                    </div>
                    <button type="submit" class="w-full py-4 rounded-xl bg-gradient-to-r from-accentBlue to-accentPurple text-black font-extrabold tracking-wide uppercase text-sm shadow-neon hover:opacity-95 transition-all">
                        Enviar Solicitação de Orçamento
                    </button>
                </form>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-800 bg-[#05070c] py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-center sm:text-left space-y-4 sm:space-y-0">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-accentBlue to-accentPurple flex items-center justify-center">
                    <i class="fa-solid fa-cube text-black text-xs font-bold"></i>
                </div>
                <span class="text-sm font-bold tracking-wider text-white">WEBFORGE © 2026. Todos os direitos reservados.</span>
            </div>
            <div class="flex space-x-6 text-gray-400 text-sm">
                <a href="#" class="hover:text-accentBlue transition-colors"><i class="fa-brands fa-github text-lg"></i></a>
                <a href="#" class="hover:text-accentBlue transition-colors"><i class="fa-brands fa-linkedin text-lg"></i></a>
                <a href="#" class="hover:text-accentBlue transition-colors"><i class="fa-brands fa-instagram text-lg"></i></a>
            </div>
        </div>
    </footer>

    <!-- Admin Login Modal -->
    <div id="admin-login-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden">
        <div class="glass-panel p-8 rounded-3xl w-full max-w-md relative border border-accentBlue/30 shadow-neon">
            <button onclick="closeAdminLoginModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
            <div class="text-center mb-6">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-accentBlue to-accentPurple mx-auto flex items-center justify-center mb-3 shadow-neon">
                    <i class="fa-solid fa-lock text-black text-lg"></i>
                </div>
                <h3 class="text-xl font-bold">Acesso Administrador</h3>
                <p class="text-xs text-gray-400 mt-1">Insira suas credenciais exclusivas Zayro</p>
            </div>
            <form onsubmit="handleAdminLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Usuário</label>
                    <input type="text" id="admin-user-input" required placeholder="Usuário" class="w-full bg-[#090d16] border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accentBlue">
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Senha</label>
                    <input type="password" id="admin-pass-input" required placeholder="Senha" class="w-full bg-[#090d16] border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accentBlue">
                </div>
                <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-accentBlue to-accentPurple text-black font-bold uppercase text-sm shadow-neon hover:opacity-90 transition-all">
                    Entrar no Painel CMS
                </button>
            </form>
        </div>
    </div>

    <!-- Admin CMS Dashboard Modal / Full Overlay -->
    <div id="admin-dashboard" class="fixed inset-0 z-50 bg-[#090d16] overflow-y-auto hidden">
        <!-- Top Admin Header Bar -->
        <div class="glass-panel border-b border-gray-800 sticky top-0 z-50 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-4">
                <!-- Official Personalized Administrator Badge -->
                <div class="flex items-center space-x-3 px-4 py-2 rounded-2xl bg-gradient-to-r from-accentBlue/20 via-accentPurple/20 to-pink-500/20 border border-accentBlue/50 shadow-neon">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-r from-accentBlue to-accentPurple flex items-center justify-center text-black font-bold text-xs shadow-md">
                        <i class="fa-solid fa-crown text-black"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-1.5">
                            <span class="text-xs font-extrabold uppercase text-white tracking-wider">Zayro</span>
                            <span class="px-1.5 py-0.5 rounded text-[9px] bg-accentBlue text-black font-bold">ADMIN MASTER</span>
                        </div>
                        <span class="text-[10px] text-gray-300">Emblema Oficial Verificado</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <button onclick="exportSiteData()" class="px-4 py-2 rounded-xl bg-gray-800 hover:bg-gray-700 text-xs font-semibold text-gray-200 border border-gray-700 transition-colors">
                    <i class="fa-solid fa-download mr-1.5"></i> Exportar Dados
                </button>
                <button onclick="resetDefaultData()" class="px-4 py-2 rounded-xl bg-red-900/30 hover:bg-red-900/50 text-xs font-semibold text-red-300 border border-red-700/50 transition-colors">
                    <i class="fa-solid fa-rotate-right mr-1.5"></i> Restaurar Padrão
                </button>
                <button onclick="closeAdminDashboard()" class="px-4 py-2 rounded-xl bg-accentBlue hover:bg-cyan-400 text-black font-bold text-xs shadow-neon transition-all">
                    <i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i> Sair do Painel
                </button>
            </div>
        </div>

        <!-- CMS Content Body -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
            <div>
                <h1 class="text-3xl font-extrabold mb-2">Painel de Gerenciamento WebForge</h1>
                <p class="text-gray-400">Edite textos da página principal, gerencie serviços, adicione portfólios com upload de imagens e personalize seu site em tempo real.</p>
            </div>

            <!-- Edit Hero Section Form -->
            <div class="glass-panel p-6 sm:p-8 rounded-3xl space-y-6">
                <h2 class="text-xl font-bold flex items-center space-x-2 text-accentBlue">
                    <i class="fa-solid fa-heading"></i>
                    <span>Editar Seção Principal (Hero)</span>
                </h2>
                <div class="grid grid-cols-1 gap-4">
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Título Principal</label>
                        <input type="text" id="edit-hero-title" class="w-full bg-[#090d16] border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accentBlue">
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Subtítulo / Descrição</label>
                        <textarea id="edit-hero-subtitle" rows="2" class="w-full bg-[#090d16] border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accentBlue"></textarea>
                    </div>
                </div>
                <button onclick="saveHeroChanges()" class="px-6 py-3 rounded-xl bg-gradient-to-r from-accentBlue to-blue-600 text-black font-bold text-xs uppercase tracking-wider shadow-neon hover:opacity-90">
                    Salvar Alterações do Hero
                </button>
            </div>

            <!-- Manage Services -->
            <div class="glass-panel p-6 sm:p-8 rounded-3xl space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-bold flex items-center space-x-2 text-accentBlue">
                        <i class="fa-solid fa-server"></i>
                        <span>Gerenciar Serviços</span>
                    </h2>
                    <button onclick="openAddServiceModal()" class="px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-black font-bold text-xs">
                        <i class="fa-solid fa-plus mr-1"></i> Adicionar Serviço
                    </button>
                </div>
                <div id="admin-services-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Loaded via JS -->
                </div>
            </div>

            <!-- Manage Portfolio & Upload Image -->
            <div class="glass-panel p-6 sm:p-8 rounded-3xl space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-bold flex items-center space-x-2 text-accentBlue">
                        <i class="fa-solid fa-images"></i>
                        <span>Portfólio & Upload de Imagens</span>
                    </h2>
                </div>
                
                <!-- Add Portfolio Item Form with File Upload -->
                <div class="p-6 rounded-2xl bg-[#090d16] border border-gray-800 space-y-4">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-gray-300">Adicionar Novo Projeto ao Portfólio</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Nome do Projeto</label>
                            <input type="text" id="new-port-title" placeholder="Ex: Portal Corporativo XYZ" class="w-full bg-cardBg border border-gray-700 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-accentBlue">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Categoria</label>
                            <input type="text" id="new-port-category" placeholder="Ex: Grandes Empresas / Automação" class="w-full bg-cardBg border border-gray-700 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-accentBlue">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Descrição do Projeto</label>
                        <input type="text" id="new-port-desc" placeholder="Breve resumo da solução entregue..." class="w-full bg-cardBg border border-gray-700 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-accentBlue">
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1 font-semibold">Fazer Upload de Imagem (ou colar URL)</label>
                        <div class="flex flex-col sm:flex-row gap-3">
                            <input type="file" id="new-port-file" accept="image/*" class="w-full text-xs text-gray-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-accentBlue file:text-black hover:file:bg-cyan-400 cursor-pointer bg-cardBg border border-gray-700 rounded-xl">
                            <input type="text" id="new-port-img-url" placeholder="Ou insira URL direta da imagem" class="w-full bg-cardBg border border-gray-700 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-accentBlue">
                        </div>
                    </div>
                    <button onclick="addPortfolioItem()" class="px-6 py-3 rounded-xl bg-gradient-to-r from-accentBlue to-accentPurple text-black font-bold text-xs uppercase tracking-wide shadow-neon hover:opacity-90">
                        <i class="fa-solid fa-cloud-arrow-up mr-1.5"></i> Publicar Projeto com Imagem no Site
                    </button>
                </div>

                <!-- Existing Portfolio Items List for deletion/editing -->
                <div id="admin-portfolio-list" class="space-y-3">
                    <!-- Loaded via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript Application Logic & CMS Engine -->
    <script>
        // Default Data State
