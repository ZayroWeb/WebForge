                <!-- Add Portfolio Item Form with File Upload -->
                <div class="p-6 rounded-2xl bg-[#090d16] border border-gray-800 space-y-4">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-gray-300">Adicionar Novo Projeto ao Portfólio</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
